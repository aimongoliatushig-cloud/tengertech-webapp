<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_green_clean_work_template_list" model="ir.ui.view">
        <field name="name">green.clean.work.template.list</field><field name="model">green.clean.work.template</field>
        <field name="arch" type="xml"><list decoration-muted="not active"><field name="name"/><field name="category_id"/><field name="work_kind"/><field name="frequency"/><field name="daily_planned_quantity"/><field name="total_planned_quantity"/><field name="completed_quantity"/><field name="remaining_quantity"/><field name="progress_percent" widget="progressbar"/><field name="unit_id"/><field name="responsible_employee_id"/><field name="crew_team_id"/><field name="last_generated_date"/><field name="active"/></list></field>
    </record>
    <record id="view_green_clean_work_template_form" model="ir.ui.view">
        <field name="name">green.clean.work.template.form</field><field name="model">green.clean.work.template</field>
        <field name="arch" type="xml"><form string="Ажлын загвар"><header><button name="action_generate_task" type="object" string="Өнөөдрийн ажил үүсгэх" class="btn-primary"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="department_id"/><field name="category_id"/><field name="work_kind"/><field name="active"/></group><group><field name="frequency" invisible="work_kind == 'one_time'"/><field name="weekday_ids" widget="many2many_tags" invisible="frequency != 'weekdays'"/><field name="interval_days" invisible="frequency != 'custom'"/><field name="day_of_month" invisible="frequency != 'monthly'"/><field name="start_date"/><field name="end_date"/></group></group><notebook><page string="Төлөвлөгөө"><group><group><field name="unit_id"/><field name="daily_planned_quantity"/><field name="total_planned_quantity"/><field name="allow_over_completion"/></group><group><field name="responsible_employee_id"/><field name="crew_team_id"/><field name="team_leader_id"/><field name="generation_time" widget="float_time"/></group></group></page><page string="Байршил"><group><field name="location_id"/><field name="khoroo"/><field name="street"/><field name="area_name"/><field name="object_name"/><field name="location_name"/><field name="gps_latitude"/><field name="gps_longitude"/></group></page><page string="Нотолгоо, хяналт"><group><field name="requires_photo"/><field name="requires_gps"/><field name="requires_approval"/></group></page><page string="Усалгаа"><group><field name="watering_liters_per_tree"/><field name="watering_vehicle_id"/><field name="watering_driver_id"/></group></page><page string="Үүсгэлт"><group><field name="last_generated_date" readonly="1"/><field name="generated_task_count" readonly="1"/></group></page></notebook></sheet><chatter/></form></field>
    </record>
    <record id="view_green_clean_work_template_search" model="ir.ui.view"><field name="name">green.clean.work.template.search</field><field name="model">green.clean.work.template</field><field name="arch" type="xml"><search><field name="name"/><field name="category_id"/><field name="responsible_employee_id"/><field name="crew_team_id"/><field name="location_name"/><field name="start_date"/><field name="end_date"/><filter name="active" string="Идэвхтэй" domain="[('active','=',True)]"/><filter name="recurring" string="Давтагддаг" domain="[('work_kind','=','recurring')]"/><filter name="quantity" string="Тоо хэмжээтэй" domain="[('work_kind','=','quantity')]"/><group><filter name="group_category" string="Ангилал" context="{'group_by':'category_id'}"/><filter name="group_kind" string="Төрөл" context="{'group_by':'work_kind'}"/><filter name="group_responsible" string="Хариуцагч" context="{'group_by':'responsible_employee_id'}"/></group></search></field></record>
    <record id="action_green_clean_work_template" model="ir.actions.act_window"><field name="name">Ажлын загвар</field><field name="res_model">green.clean.work.template</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_green_clean_work_template_search"/></record>
    <record id="action_green_clean_categories" model="ir.actions.act_window"><field name="name">Ажлын ангилал</field><field name="res_model">green.clean.work.category</field><field name="view_mode">list,form</field></record>
    <record id="action_green_clean_units" model="ir.actions.act_window"><field name="name">Хэмжих нэгж</field><field name="res_model">green.clean.unit</field><field name="view_mode">list,form</field></record>
</odoo>
