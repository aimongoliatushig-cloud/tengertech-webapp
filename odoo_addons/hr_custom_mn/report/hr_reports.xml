<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_hr_custom_mn_generic" model="ir.actions.report">
        <field name="name">HR тайлан</field>
        <field name="model">hr.custom.mn.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_custom_mn.report_hr_custom_mn_generic</field>
        <field name="report_file">hr_custom_mn.report_hr_custom_mn_generic</field>
        <field name="print_report_name">object._report_title()</field>
    </record>

    <template id="report_hr_custom_mn_generic">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="report_data" t-value="doc.get_report_lines()"/>
                <t t-set="lines" t-value="report_data[0]"/>
                <t t-set="headers" t-value="report_data[1]"/>
                <t t-call="web.basic_layout">
                    <div class="page">
                        <style>
                            .hr-mn-report-page,
                            .hr-mn-report-page * {
                                font-family: Arial, sans-serif !important;
                            }
                            .hr-mn-report-header {
                                display: block;
                                margin-bottom: 28px;
                            }
                            .hr-mn-report-logo {
                                display: block;
                                max-width: 120px;
                                max-height: 54px;
                                object-fit: contain;
                            }
                            .hr-mn-report-title {
                                margin: 0 0 10px;
                                font-family: Arial, sans-serif !important;
                                font-size: 24px;
                                font-weight: 500;
                                line-height: 1.25;
                            }
                            .hr-mn-report-period {
                                margin: 0 0 16px;
                                font-family: Arial, sans-serif !important;
                                font-size: 14px;
                            }
                            .hr-mn-report-table {
                                width: 100%;
                                border-collapse: collapse;
                                font-family: Arial, sans-serif !important;
                                font-size: 13px;
                            }
                            .hr-mn-report-table th,
                            .hr-mn-report-table td {
                                border: 1px solid #1f2b25;
                                padding: 5px 7px;
                                text-align: left;
                                vertical-align: top;
                            }
                            .hr-mn-report-table th {
                                font-weight: 500;
                            }
                        </style>
                        <div class="hr-mn-report-page">
                        <div class="hr-mn-report-header">
                            <img t-if="doc.env.company.logo" class="hr-mn-report-logo" t-att-src="image_data_uri(doc.env.company.logo)" alt="Logo"/>
                        </div>
                        <h2 class="hr-mn-report-title" t-esc="doc._report_title()"/>
                        <p class="hr-mn-report-period">
                            <strong>Хугацаа:</strong>
                            <span t-esc="doc.date_from"/>
                            <span> - </span>
                            <span t-esc="doc.date_to"/>
                        </p>
                        <table class="hr-mn-report-table">
                            <thead>
                                <tr>
                                    <t t-foreach="headers" t-as="header">
                                        <th t-esc="header"/>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="lines" t-as="line">
                                    <t t-foreach="line.get('values')" t-as="value">
                                        <td t-esc="value"/>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
